    "description": "Framework para gerar migrations de diff comparando schema esperado e o atual do banco de dados",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Seu Nome",
            "email": "seu.email@exemplo.com"
        }
